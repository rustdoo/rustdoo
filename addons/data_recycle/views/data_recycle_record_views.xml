<?xml version="1.0" encoding="utf-8"?>
<!-- As sugestões: o que a regra separou, esperando alguém decidir. -->
<odoo>
    <record id="view_recycle_record_list" model="ir.ui.view">
        <field name="name">data_recycle.record.list</field>
        <field name="model">data_recycle.record</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="name" string="Registro"/><field name="res_model_name" string="Modelo"/><field name="res_id" string="ID"/><field name="recycle_model_id" string="Regra"/></list></field>
    </record>

    <record id="view_recycle_record_form" model="ir.ui.view">
        <field name="name">data_recycle.record.form</field>
        <field name="model">data_recycle.record</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><button name="action_validate" type="object" string="Validar" class="btn-danger"/><button name="action_discard" type="object" string="Manter o registro"/><group><field name="name" string="Registro"/><field name="recycle_model_id" string="Regra"/></group><group><field name="res_model_name" string="Modelo"/><field name="res_id" string="ID"/><field name="active" string="Aberto"/></group></form></field>
    </record>

    <record id="view_recycle_record_search" model="ir.ui.view">
        <field name="name">data_recycle.record.search</field>
        <field name="model">data_recycle.record</field>
        <field name="type">search</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="res_model_name"/><filter name="discarded" string="Descartados" domain="[[&quot;active&quot;, &quot;=&quot;, false]]"/><groupby name="recycle_model_id" string="Regra"/><groupby name="res_model_name" string="Modelo"/></search></field>
    </record>

    <record id="action_recycle_records" model="ir.actions.act_window">
        <field name="name">Registros a reciclar</field>
        <field name="res_model">data_recycle.record</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
