<?xml version="1.0" encoding="utf-8"?>
<!-- A varredura diária. noupdate: o administrador desliga ou espaça o
     job conforme o tamanho do banco, e uma atualização do módulo não
     desfaz essa decisão. -->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_recycle_records" model="ir.cron">
            <field name="name">Reciclagem de dados: varrer registros</field>
            <field name="model">data_recycle.model</field>
            <field name="code">cron_recycle_records</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">1</field>
        </record>
    </data>
</odoo>
