<?xml version="1.0" encoding="utf-8"?>
<!-- A forma de pagamento que o módulo inteiro existe para servir, com o
     mesmo identificador externo do Odoo: um módulo de cheque por país vai
     referenciar `account_check_printing.account_payment_method_check`.

     `code` é o que o resto do módulo consulta — é ele, e não o nome, que
     decide se um pagamento é cheque. -->
<odoo noupdate="1">
    <record id="account_payment_method_check" model="account.payment.method">
        <field name="name">Cheque</field>
        <field name="code">check_printing</field>
        <field name="payment_type">outbound</field>
    </record>
</odoo>
