<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_list" model="ir.ui.view">
        <field name="name">calendar.event.list</field>
        <field name="model">calendar.event</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="name" string="Reunião"/><field name="start" string="Início"/><field name="stop" string="Fim"/><field name="duration" string="Duração"/><field name="user_id" string="Organizador"/><field name="location" string="Local"/></list></field>
    </record>

    <record id="view_event_form" model="ir.ui.view">
        <field name="name">calendar.event.form</field>
        <field name="model">calendar.event</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><group><field name="name" string="Reunião"/><field name="user_id" string="Organizador"/><field name="location" string="Local"/><field name="videocall_location" string="Videochamada"/><field name="show_as" string="Mostrar como"/><field name="active" string="Ativa"/></group><group><field name="start" string="Início"/><field name="stop" string="Fim"/><field name="allday" string="Dia inteiro"/><field name="duration" string="Duração"/><field name="privacy" string="Privacidade"/></group><field name="description" string="Descrição"/><field name="attendee_ids"><list><field name="partner_id" string="Convidado"/><field name="state" string="Resposta"/></list></field></form></field>
    </record>

    <record id="view_event_search" model="ir.ui.view">
        <field name="name">calendar.event.search</field>
        <field name="model">calendar.event</field>
        <field name="type">search</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="user_id"/><field name="location"/><groupby name="user_id" string="Organizador"/></search></field>
    </record>

    <record id="action_events" model="ir.actions.act_window">
        <field name="name">Reuniões</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_alarm_list" model="ir.ui.view">
        <field name="name">calendar.alarm.list</field>
        <field name="model">calendar.alarm</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="name" string="Lembrete"/><field name="alarm_type" string="Tipo"/><field name="duration" string="Antecedência"/><field name="interval" string="Unidade"/></list></field>
    </record>

    <record id="action_alarms" model="ir.actions.act_window">
        <field name="name">Lembretes</field>
        <field name="res_model">calendar.alarm</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
