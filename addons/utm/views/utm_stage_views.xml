<?xml version="1.0" encoding="utf-8"?>
<!-- A sequência aparece na lista porque é ela que decide a ordem das
     colunas do quadro de campanhas, e o estágio em que uma campanha
     nova começa. -->
<odoo>
    <record id="view_stage_list" model="ir.ui.view">
        <field name="name">utm.stage.list</field>
        <field name="model">utm.stage</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="sequence" string="Ordem"/><field name="name" string="Estágio"/></list></field>
    </record>

    <record id="view_stage_form" model="ir.ui.view">
        <field name="name">utm.stage.form</field>
        <field name="model">utm.stage</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><group><field name="name" string="Estágio"/><field name="sequence" string="Ordem"/></group></form></field>
    </record>

    <record id="utm_stage_action" model="ir.actions.act_window">
        <field name="name">Estágios das campanhas</field>
        <field name="res_model">utm.stage</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
