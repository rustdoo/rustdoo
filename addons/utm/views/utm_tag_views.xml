<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tag_list" model="ir.ui.view">
        <field name="name">utm.tag.list</field>
        <field name="model">utm.tag</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="name" string="Etiqueta"/><field name="color" string="Cor"/></list></field>
    </record>

    <record id="view_tag_form" model="ir.ui.view">
        <field name="name">utm.tag.form</field>
        <field name="model">utm.tag</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><group><field name="name" string="Etiqueta"/><field name="color" string="Cor"/></group></form></field>
    </record>

    <record id="utm_tag_action" model="ir.actions.act_window">
        <field name="name">Etiquetas das campanhas</field>
        <field name="res_model">utm.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
