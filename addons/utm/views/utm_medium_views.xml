<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medium_list" model="ir.ui.view">
        <field name="name">utm.medium.list</field>
        <field name="model">utm.medium</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="name" string="Meio"/><field name="active" string="Ativo"/></list></field>
    </record>

    <record id="view_medium_form" model="ir.ui.view">
        <field name="name">utm.medium.form</field>
        <field name="model">utm.medium</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><group><field name="name" string="Meio"/><field name="active" string="Ativo"/></group></form></field>
    </record>

    <record id="view_medium_search" model="ir.ui.view">
        <field name="name">utm.medium.search</field>
        <field name="model">utm.medium</field>
        <field name="type">search</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><search><field name="name"/><filter name="archived" string="Arquivados" domain="[[&quot;active&quot;, &quot;=&quot;, false]]"/></search></field>
    </record>

    <record id="utm_medium_action" model="ir.actions.act_window">
        <field name="name">Meios</field>
        <field name="res_model">utm.medium</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
