<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- O rastro dos ajustes de mão: no Odoo é a prova de uma decisão que
         um recálculo apagaria. -->
    <record id="view_product_value_list" model="ir.ui.view">
        <field name="name">product.value.list</field>
        <field name="model">product.value</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="date" string="Data"/><field name="product_id" string="Produto"/><field name="value" string="Valor"/><field name="user_id" string="Quem ajustou"/><field name="description" string="Motivo"/></list></field>
    </record>

    <record id="view_product_value_form" model="ir.ui.view">
        <field name="name">product.value.form</field>
        <field name="model">product.value</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><group><field name="product_id" string="Produto"/><field name="value" string="Valor"/><field name="date" string="Data"/><field name="user_id" string="Quem ajustou"/></group><group><field name="description" string="Motivo"/></group></form></field>
    </record>

    <record id="action_product_values" model="ir.actions.act_window">
        <field name="name">Ajustes de valoração</field>
        <field name="res_model">product.value</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
