<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lead_list" model="ir.ui.view">
        <field name="name">crm.lead.list</field>
        <field name="model">crm.lead</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="name" string="Oportunidade"/><field name="partner_id" string="Cliente"/><field name="contact_name" string="Contato"/><field name="email_from" string="E-mail"/><field name="stage_id" string="Etapa"/><field name="expected_revenue" string="Receita esperada"/><field name="probability" string="Probabilidade"/><field name="user_id" string="Responsável"/></list></field>
    </record>

    <record id="view_lead_form" model="ir.ui.view">
        <field name="name">crm.lead.form</field>
        <field name="model">crm.lead</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><group><field name="name" string="Oportunidade"/><field name="type" string="Tipo"/><field name="stage_id" string="Etapa"/><field name="user_id" string="Responsável"/><field name="team_id" string="Equipe"/><field name="priority" string="Prioridade"/></group><group><field name="partner_id" string="Cliente"/><field name="contact_name" string="Contato"/><field name="partner_name" string="Empresa"/><field name="email_from" string="E-mail"/><field name="phone" string="Telefone"/><field name="city" string="Cidade"/></group><group string="Negócio"><field name="expected_revenue" string="Receita esperada"/><field name="probability" string="Probabilidade"/><field name="date_deadline" string="Fechamento previsto"/><field name="date_closed" string="Fechado em"/><field name="lost_reason_id" string="Motivo da perda"/><field name="active" string="Ativo"/></group><group string="Origem"><field name="source_id" string="Origem"/><field name="medium_id" string="Meio"/><field name="campaign_id" string="Campanha"/><field name="tag_ids" string="Marcadores"/></group><field name="description" string="Anotações"/></form></field>
    </record>

    <record id="view_lead_search" model="ir.ui.view">
        <field name="name">crm.lead.search</field>
        <field name="model">crm.lead</field>
        <field name="type">search</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="partner_id"/><field name="email_from"/><filter name="opportunities" string="Oportunidades" domain="[[&quot;type&quot;, &quot;=&quot;, &quot;opportunity&quot;]]"/><filter name="leads" string="Leads" domain="[[&quot;type&quot;, &quot;=&quot;, &quot;lead&quot;]]"/><groupby name="stage_id" string="Etapa"/><groupby name="user_id" string="Responsável"/></search></field>
    </record>

    <record id="view_lead_kanban" model="ir.ui.view">
        <field name="name">crm.lead.kanban</field>
        <field name="model">crm.lead</field>
        <field name="type">kanban</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><kanban default_group_by="stage_id"><field name="name"/><field name="partner_id" string="Cliente"/><field name="expected_revenue" string="Receita esperada"/><field name="user_id" string="Responsável"/></kanban></field>
    </record>

    <record id="action_opportunities" model="ir.actions.act_window">
        <field name="name">Funil</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_stage_list" model="ir.ui.view">
        <field name="name">crm.stage.list</field>
        <field name="model">crm.stage</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="sequence" string="Ordem"/><field name="name" string="Etapa"/><field name="is_won" string="É ganho"/><field name="team_id" string="Equipe"/></list></field>
    </record>

    <record id="action_stages" model="ir.actions.act_window">
        <field name="name">Etapas</field>
        <field name="res_model">crm.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_lost_reason_list" model="ir.ui.view">
        <field name="name">crm.lost.reason.list</field>
        <field name="model">crm.lost.reason</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="name" string="Motivo da perda"/><field name="active" string="Ativo"/></list></field>
    </record>

    <record id="action_lost_reasons" model="ir.actions.act_window">
        <field name="name">Motivos de perda</field>
        <field name="res_model">crm.lost.reason</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
