<?xml version="1.0" encoding="utf-8"?>
<!-- Os três lugares que todo estoque tem: o depósito, e as duas pontas
     por onde a mercadoria entra e sai da empresa. -->
<odoo>
    <data noupdate="1">
        <record id="stock_location_stock" model="stock.location">
            <field name="name">Depósito</field>
            <field name="complete_name">Empresa/Depósito</field>
            <field name="usage">internal</field>
        </record>
        <record id="stock_location_customers" model="stock.location">
            <field name="name">Clientes</field>
            <field name="complete_name">Parceiros/Clientes</field>
            <field name="usage">customer</field>
        </record>
        <record id="stock_location_suppliers" model="stock.location">
            <field name="name">Fornecedores</field>
            <field name="complete_name">Parceiros/Fornecedores</field>
            <field name="usage">supplier</field>
        </record>
    </data>
</odoo>
