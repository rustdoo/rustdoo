<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_list" model="ir.ui.view">
        <field name="name">stock.picking.list</field>
        <field name="model">stock.picking</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="name" string="Referência"/><field name="partner_id" string="Parceiro"/><field name="picking_type" string="Tipo"/><field name="scheduled_date" string="Data prevista"/><field name="origin" string="Origem"/><field name="state" string="Situação"/></list></field>
    </record>

    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/><button name="action_done" type="object" string="Validar"/><button name="action_cancel" type="object" string="Cancelar"/><group><field name="name" string="Referência"/><field name="partner_id" string="Parceiro"/><field name="scheduled_date" string="Data prevista"/><field name="origin" string="Origem"/></group><group><field name="picking_type" string="Tipo"/><field name="state" string="Situação"/><field name="location_id" string="Origem (local)"/><field name="location_dest_id" string="Destino"/></group><field name="move_ids" string="Movimentos"><list><field name="product_id" string="Produto"/><field name="name" string="Descrição"/><field name="product_uom_qty" string="Quantidade"/><field name="quantity_done" string="Quantidade feita"/></list></field><group><field name="note" string="Observações"/></group><chatter/></form></field>
    </record>

    <record id="view_location_list" model="ir.ui.view">
        <field name="name">stock.location.list</field>
        <field name="model">stock.location</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="complete_name" string="Local"/><field name="usage" string="Uso"/></list></field>
    </record>

    <record id="view_location_form" model="ir.ui.view">
        <field name="name">stock.location.form</field>
        <field name="model">stock.location</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><group><field name="name" string="Nome"/><field name="complete_name" string="Nome completo"/><field name="location_id" string="Local pai"/><field name="usage" string="Uso"/><field name="active" string="Ativo"/></group></form></field>
    </record>

    <record id="action_pickings" model="ir.actions.act_window">
        <field name="name">Transferências</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_locations" model="ir.actions.act_window">
        <field name="name">Locais de estoque</field>
        <field name="res_model">stock.location</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_picking_search" model="ir.ui.view">
        <field name="name">stock.picking.search</field>
        <field name="model">stock.picking</field>
        <field name="type">search</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="origin"/><filter name="todo" string="A fazer" domain="[[&quot;state&quot;, &quot;=&quot;, &quot;confirmed&quot;]]"/><filter name="done" string="Concluídas" domain="[[&quot;state&quot;, &quot;=&quot;, &quot;done&quot;]]"/><filter name="outgoing" string="Entregas" domain="[[&quot;picking_type&quot;, &quot;=&quot;, &quot;outgoing&quot;]]"/></search></field>
    </record>
</odoo>
