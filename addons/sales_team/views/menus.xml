<?xml version="1.0" encoding="utf-8"?>
<!-- Menu próprio: no Odoo é `sale` que depende de `sales_team`, e não o
     contrário, então estas telas não podem se pendurar no menu de
     Vendas. -->
<odoo>
    <record id="menu_sales_team_root" model="ir.ui.menu">
        <field name="name">Equipes</field>
        <field name="sequence">25</field>
    </record>
    <record id="menu_crm_team" model="ir.ui.menu">
        <field name="name">Equipes de venda</field>
        <field name="parent_id" ref="menu_sales_team_root"/>
        <field name="sequence">10</field>
        <field name="action">sales_team.crm_team_action</field>
    </record>
    <record id="menu_crm_team_member" model="ir.ui.menu">
        <field name="name">Vendedores</field>
        <field name="parent_id" ref="menu_sales_team_root"/>
        <field name="sequence">20</field>
        <field name="action">sales_team.crm_team_member_action</field>
    </record>
    <record id="menu_crm_tag" model="ir.ui.menu">
        <field name="name">Etiquetas</field>
        <field name="parent_id" ref="menu_sales_team_root"/>
        <field name="sequence">30</field>
        <field name="action">sales_team.crm_tag_action</field>
    </record>
</odoo>
