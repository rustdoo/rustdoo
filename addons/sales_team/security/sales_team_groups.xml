<?xml version="1.0" encoding="utf-8"?>
<!-- Odoo tem três degraus aqui; o do meio ("User: All Documents") só
     existe para ser implicado pelos outros e alargado por uma ir.rule do
     crm. Sem hierarquia de grupos ele não faria nada, então ficam os dois
     que decidem alguma coisa: quem vende e quem configura. -->
<odoo>
    <data noupdate="1">
        <record id="group_sale_salesman" model="res.groups">
            <field name="name">Vendas: vendedor</field>
            <field name="category">Vendas</field>
            <field name="comment">Vê as equipes e mantém as etiquetas.</field>
        </record>
        <record id="group_sale_manager" model="res.groups">
            <field name="name">Vendas: administrador</field>
            <field name="category">Vendas</field>
            <field name="comment">Cria equipes e decide quem está em cada uma.</field>
        </record>
    </data>
</odoo>
