<?xml version="1.0" encoding="utf-8"?>
<!-- Odoo's multi-company record rules on these models are not here: they
     are written against `company_ids`, the list of companies the session
     is allowed to see, and the data evaluator of this port only knows how
     to name the acting user. A rule that cannot be understood must not be
     loaded half-right, so it is left out and said so. -->
<odoo>
    <data noupdate="1">
        <record id="group_analytic_accounting" model="res.groups">
            <field name="name">Analytic Accounting</field>
            <field name="category">Accounting</field>
            <field name="comment">Maintains the analytic plans, their accounts and the distribution rules.</field>
        </record>
    </data>
</odoo>
