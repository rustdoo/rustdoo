<?xml version="1.0" encoding="utf-8"?>
<!-- Odoo draws the distribution with its own `analytic_distribution`
     widget, a JS component that asks `get_relevant_plans` what to show.
     That widget is not ported; the raw JSON is shown instead, which is
     honest about what the column holds. -->
<odoo>
    <record id="account_analytic_distribution_model_view_list" model="ir.ui.view">
        <field name="name">account.analytic.distribution.model.list</field>
        <field name="model">account.analytic.distribution.model</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="sequence" string="Order"/><field name="partner_id" string="Partner"/><field name="company_id" string="Company"/><field name="analytic_distribution" string="Distribution"/></list></field>
    </record>

    <record id="account_analytic_distribution_model_view_form" model="ir.ui.view">
        <field name="name">account.analytic.distribution.model.form</field>
        <field name="model">account.analytic.distribution.model</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><group><field name="partner_id" string="Partner"/><field name="company_id" string="Company"/><field name="sequence" string="Order"/></group><group><field name="analytic_distribution" string="Distribution to apply"/></group></form></field>
    </record>

    <record id="account_analytic_distribution_model_view_search" model="ir.ui.view">
        <field name="name">account.analytic.distribution.model.search</field>
        <field name="model">account.analytic.distribution.model</field>
        <field name="type">search</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><search><field name="partner_id"/><groupby name="partner_id" string="Partner"/><groupby name="company_id" string="Company"/></search></field>
    </record>

    <record id="action_analytic_distribution_model" model="ir.actions.act_window">
        <field name="name">Analytic Distribution Models</field>
        <field name="res_model">account.analytic.distribution.model</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
