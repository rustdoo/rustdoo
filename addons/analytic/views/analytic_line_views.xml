<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_analytic_line_list" model="ir.ui.view">
        <field name="name">account.analytic.line.list</field>
        <field name="model">account.analytic.line</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="date" string="Date"/><field name="name" string="Description"/><field name="account_id" string="Analytic Account"/><field name="partner_id" string="Partner"/><field name="user_id" string="User"/><field name="unit_amount" string="Quantity"/><field name="product_uom_id" string="Unit"/><field name="amount" string="Amount"/><field name="company_id" string="Company"/></list></field>
    </record>

    <record id="view_account_analytic_line_form" model="ir.ui.view">
        <field name="name">account.analytic.line.form</field>
        <field name="model">account.analytic.line</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><group><field name="name" string="Description"/><field name="date" string="Date"/><field name="account_id" string="Analytic Account"/><field name="partner_id" string="Partner"/></group><group><field name="amount" string="Amount"/><field name="unit_amount" string="Quantity"/><field name="product_uom_id" string="Unit"/><field name="user_id" string="User"/><field name="company_id" string="Company"/><field name="category" string="Category"/></group></form></field>
    </record>

    <record id="view_account_analytic_line_search" model="ir.ui.view">
        <field name="name">account.analytic.line.search</field>
        <field name="model">account.analytic.line</field>
        <field name="type">search</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="account_id"/><field name="partner_id"/><groupby name="account_id" string="Analytic Account"/><groupby name="user_id" string="User"/><groupby name="date" string="Date"/></search></field>
    </record>

    <record id="account_analytic_line_action" model="ir.actions.act_window">
        <field name="name">Analytic Items</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
