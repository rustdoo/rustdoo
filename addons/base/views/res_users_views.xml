<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_list" model="ir.ui.view">
        <field name="name">res.users.list</field>
        <field name="model">res.users</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="login" string="Login"/><field name="name" string="Nome"/><field name="email" string="E-mail"/><field name="active" string="Ativo"/></list></field>
    </record>

    <record id="view_users_form" model="ir.ui.view">
        <field name="name">res.users.form</field>
        <field name="model">res.users</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><group><field name="login" string="Login"/><field name="name" string="Nome"/><field name="email" string="E-mail"/><field name="active" string="Ativo"/></group><group><field name="lang" string="Idioma"/><field name="tz" string="Fuso"/><field name="company_id" string="Empresa"/><field name="groups_id" string="Grupos"/></group></form></field>
    </record>

    <record id="view_groups_list" model="ir.ui.view">
        <field name="name">res.groups.list</field>
        <field name="model">res.groups</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="name" string="Nome"/><field name="category" string="Categoria"/></list></field>
    </record>

    <record id="view_groups_form" model="ir.ui.view">
        <field name="name">res.groups.form</field>
        <field name="model">res.groups</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><group><field name="name" string="Nome"/><field name="category" string="Categoria"/><field name="comment" string="Descrição"/></group></form></field>
    </record>

    <record id="action_users" model="ir.actions.act_window">
        <field name="name">Usuários</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_groups" model="ir.actions.act_window">
        <field name="name">Grupos</field>
        <field name="res_model">res.groups</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
