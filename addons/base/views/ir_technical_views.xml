    <record id="action_ir_act_report" model="ir.actions.act_window">
        <field name="name">Relatórios</field>
        <field name="res_model">ir.actions.report</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ── Parâmetros e automação ────────────────────────────────── -->
    <record id="view_ir_config_parameter_list" model="ir.ui.view">
        <field name="name">ir.config_parameter.list</field>
