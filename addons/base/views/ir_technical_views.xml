        <field name="arch" type="xml"><list><field name="name" string="Arquivo"/><field name="res_model" string="Modelo"/><field name="res_id" string="Registro"/><field name="mimetype" string="Tipo"/><field name="file_size" string="Tamanho"/></list></field>
