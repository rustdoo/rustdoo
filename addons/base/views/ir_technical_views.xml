        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="name" string="Tarefa"/><field name="model" string="Modelo"/><field name="method" string="Método"/><field name="interval_number" string="A cada"/><field name="interval_type" string="Unidade"/><field name="nextcall" string="Próxima execução"/><field name="active" string="Ativa"/></list></field>
