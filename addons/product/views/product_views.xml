<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_list" model="ir.ui.view">
        <field name="name">product.product.list</field>
        <field name="model">product.product</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="default_code" string="Referência"/><field name="name" string="Produto"/><field name="categ_id" string="Categoria"/><field name="type" string="Tipo"/><field name="list_price" string="Preço"/></list></field>
    </record>

    <record id="view_product_form" model="ir.ui.view">
        <field name="name">product.product.form</field>
        <field name="model">product.product</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><group><field name="image_1920" string="Imagem"/><field name="name" string="Produto"/><field name="default_code" string="Referência"/><field name="categ_id" string="Categoria"/><field name="type" string="Tipo"/><field name="active" string="Ativo"/></group><group><field name="list_price" string="Preço de venda"/><field name="standard_price" string="Custo"/><field name="description" string="Descrição"/></group></form></field>
    </record>

    <record id="action_products" model="ir.actions.act_window">
        <field name="name">Produtos</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="view_product_search" model="ir.ui.view">
        <field name="name">product.product.search</field>
        <field name="model">product.product</field>
        <field name="type">search</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="default_code"/><field name="categ_id"/><filter name="goods" string="Produtos" domain="[[&quot;type&quot;, &quot;=&quot;, &quot;consu&quot;]]"/><filter name="services" string="Serviços" domain="[[&quot;type&quot;, &quot;=&quot;, &quot;service&quot;]]"/><groupby name="type" string="Tipo"/><groupby name="categ_id" string="Categoria"/></search></field>
    </record>

    <record id="view_product_kanban" model="ir.ui.view">
        <field name="name">product.product.kanban</field>
        <field name="model">product.product</field>
        <field name="type">kanban</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><kanban default_group_by="type"><field name="name"/><field name="default_code"/><field name="list_price"/><templates><t t-name="card"><field name="name"/><field name="default_code"/><field name="list_price"/></t></templates></kanban></field>
    </record>

    <!-- The catalogue as it is described, one record per product rather
         than one per variant. Odoo opens this one from the Sales menu and
         the variants from Configuration; here both are reachable, and the
         list makes it visible that the name and the price are the
         template's. -->
    <record id="view_template_list" model="ir.ui.view">
        <field name="name">product.template.list</field>
        <field name="model">product.template</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="name" string="Produto"/><field name="categ_id" string="Categoria"/><field name="type" string="Tipo"/><field name="list_price" string="Preço de venda"/></list></field>
    </record>

    <record id="view_template_form" model="ir.ui.view">
        <field name="name">product.template.form</field>
        <field name="model">product.template</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><group><field name="image_1920" string="Imagem"/><field name="name" string="Produto"/><field name="categ_id" string="Categoria"/><field name="type" string="Tipo"/><field name="active" string="Ativo"/></group><group><field name="list_price" string="Preço de venda"/><field name="description" string="Descrição"/></group></form></field>
    </record>

    <record id="action_templates" model="ir.actions.act_window">
        <field name="name">Catálogo</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_category_list" model="ir.ui.view">
        <field name="name">product.category.list</field>
        <field name="model">product.category</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="name" string="Categoria"/><field name="parent_id" string="Categoria pai"/></list></field>
    </record>

    <record id="view_category_form" model="ir.ui.view">
        <field name="name">product.category.form</field>
        <field name="model">product.category</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><group><field name="name" string="Categoria"/><field name="parent_id" string="Categoria pai"/></group></form></field>
    </record>

    <record id="action_categories" model="ir.actions.act_window">
        <field name="name">Categorias de produto</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
