<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_list" model="ir.ui.view">
        <field name="name">lunch.product.list</field>
        <field name="model">lunch.product</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="name" string="Prato"/><field name="category_id" string="Categoria"/><field name="supplier_id" string="Fornecedor"/><field name="price" string="Preço"/><field name="active" string="Ativo"/></list></field>
    </record>

    <record id="view_product_form" model="ir.ui.view">
        <field name="name">lunch.product.form</field>
        <field name="model">lunch.product</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><group><field name="name" string="Prato"/><field name="category_id" string="Categoria"/><field name="supplier_id" string="Fornecedor"/></group><group><field name="price" string="Preço"/><field name="active" string="Ativo"/><field name="description" string="Descrição"/></group></form></field>
    </record>

    <record id="action_products" model="ir.actions.act_window">
        <field name="name">Cardápio</field>
        <field name="res_model">lunch.product</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_order_list" model="ir.ui.view">
        <field name="name">lunch.order.list</field>
        <field name="model">lunch.order</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="date" string="Data"/><field name="user_id" string="Quem pediu"/><field name="product_id" string="Prato"/><field name="quantity" string="Qtd."/><field name="price" string="Valor"/><field name="state" string="Situação"/></list></field>
    </record>

    <record id="action_orders" model="ir.actions.act_window">
        <field name="name">Meus pedidos</field>
        <field name="res_model">lunch.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_supplier_list" model="ir.ui.view">
        <field name="name">lunch.supplier.list</field>
        <field name="model">lunch.supplier</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="name" string="Fornecedor"/><field name="phone" string="Telefone"/><field name="send_by" string="Como pedir"/><field name="active" string="Ativo"/></list></field>
    </record>

    <record id="action_suppliers" model="ir.actions.act_window">
        <field name="name">Fornecedores</field>
        <field name="res_model">lunch.supplier</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_cashmove_list" model="ir.ui.view">
        <field name="name">lunch.cashmove.list</field>
        <field name="model">lunch.cashmove</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="date" string="Data"/><field name="user_id" string="Pessoa"/><field name="description" string="Histórico"/><field name="amount" string="Valor"/></list></field>
    </record>

    <record id="action_cashmoves" model="ir.actions.act_window">
        <field name="name">Carteira</field>
        <field name="res_model">lunch.cashmove</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
