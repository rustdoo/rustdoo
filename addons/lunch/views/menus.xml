<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="menu_lunch_root" model="ir.ui.menu">
        <field name="name">Almoço</field>
        <field name="sequence">70</field>
    </record>
    <record id="menu_orders" model="ir.ui.menu">
        <field name="name">Meus pedidos</field>
        <field name="parent_id" ref="menu_lunch_root"/>
