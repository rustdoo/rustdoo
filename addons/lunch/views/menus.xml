        <field name="sequence">20</field>
        <field name="action">lunch.action_products</field>
    </record>
    <record id="menu_suppliers" model="ir.ui.menu">
        <field name="name">Fornecedores</field>
        <field name="parent_id" ref="menu_lunch_root"/>
        <field name="sequence">30</field>
        <field name="action">lunch.action_suppliers</field>
    </record>
    <record id="menu_cashmoves" model="ir.ui.menu">
        <field name="name">Carteira</field>
        <field name="parent_id" ref="menu_lunch_root"/>
        <field name="sequence">40</field>
        <field name="action">lunch.action_cashmoves</field>
    </record>
</odoo>
