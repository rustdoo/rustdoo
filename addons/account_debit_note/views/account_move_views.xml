<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Uma herança de view: este módulo publica o que muda no form de
         `account`, não uma cópia dele. Quem mexer no form de lá não
         precisa lembrar deste arquivo. -->
    <record id="view_move_form_debit" model="ir.ui.view">
        <field name="name">account.move.form.debit</field>
        <field name="model">account.move</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml"><data><xpath expr="//button[@name='action_draft']" position="after"><button name="action_debit_note" type="object" string="Nota de débito"/><button name="action_view_debit_notes" type="object" string="Ver as notas de débito"/></xpath><xpath expr="//field[@name='invoice_origin']" position="after"><field name="debit_origin_id" string="Fatura debitada" readonly="1"/><field name="debit_note_count" string="Notas de débito emitidas" readonly="1"/></xpath></data></field>
    </record>

    <record id="action_debit_notes" model="ir.actions.act_window">
        <field name="name">Notas de débito</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[["debit_origin_id", "!=", false]]</field>
    </record>
</odoo>
