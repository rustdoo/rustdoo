<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Série própria: uma nota de débito não consome um número da
             série das faturas, para que a numeração de um mês não tenha
             buracos por causa de correções. -->
        <record id="seq_account_move_debit" model="ir.sequence">
            <field name="name">Nota de débito</field>
            <field name="code">account.move.debit</field>
            <field name="prefix">FAT/D</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
        </record>
    </data>
</odoo>
