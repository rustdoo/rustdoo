<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_request_list" model="ir.ui.view">
        <field name="name">maintenance.request.list</field>
        <field name="model">maintenance.request</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="name" string="Solicitação"/><field name="equipment_id" string="Equipamento"/><field name="maintenance_type" string="Tipo"/><field name="request_date" string="Aberta em"/><field name="stage_id" string="Etapa"/><field name="user_id" string="Responsável"/></list></field>
    </record>

    <record id="view_request_form" model="ir.ui.view">
        <field name="name">maintenance.request.form</field>
        <field name="model">maintenance.request</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><group><field name="name" string="Solicitação"/><field name="equipment_id" string="Equipamento"/><field name="category_id" string="Categoria"/><field name="maintenance_type" string="Tipo"/><field name="priority" string="Prioridade"/></group><group><field name="stage_id" string="Etapa"/><field name="user_id" string="Responsável"/><field name="maintenance_team_id" string="Equipe"/><field name="request_date" string="Aberta em"/><field name="schedule_date" string="Agendada para"/><field name="close_date" string="Fechada em"/><field name="duration" string="Duração (h)"/></group><field name="description" string="Descrição"/></form></field>
    </record>

    <record id="view_request_kanban" model="ir.ui.view">
        <field name="name">maintenance.request.kanban</field>
        <field name="model">maintenance.request</field>
        <field name="type">kanban</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><kanban default_group_by="stage_id"><field name="name"/><field name="equipment_id"/><field name="maintenance_type"/><field name="user_id"/><templates><t t-name="card"><field name="name"/><field name="equipment_id"/><field name="maintenance_type"/><field name="user_id"/></t></templates></kanban></field>
    </record>

    <record id="action_requests" model="ir.actions.act_window">
        <field name="name">Solicitações</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_equipment_list" model="ir.ui.view">
        <field name="name">maintenance.equipment.list</field>
        <field name="model">maintenance.equipment</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="name" string="Equipamento"/><field name="category_id" string="Categoria"/><field name="serial_no" string="Série"/><field name="employee_id" string="Com quem"/><field name="maintenance_open_count" string="Em aberto"/></list></field>
    </record>

    <record id="view_equipment_form" model="ir.ui.view">
        <field name="name">maintenance.equipment.form</field>
        <field name="model">maintenance.equipment</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><group><field name="name" string="Equipamento"/><field name="category_id" string="Categoria"/><field name="serial_no" string="Número de série"/><field name="model" string="Modelo"/><field name="location" string="Local"/><field name="active" string="Ativo"/></group><group><field name="employee_id" string="Com quem"/><field name="department_id" string="Departamento"/><field name="technician_user_id" string="Técnico"/><field name="maintenance_team_id" string="Equipe"/><field name="effective_date" string="Em uso desde"/><field name="warranty_date" string="Garantia até"/><field name="cost" string="Custo"/></group><field name="maintenance_ids"><list><field name="name" string="Solicitação"/><field name="maintenance_type" string="Tipo"/><field name="stage_id" string="Etapa"/></list></field><field name="note" string="Observações"/></form></field>
    </record>

    <record id="action_equipments" model="ir.actions.act_window">
        <field name="name">Equipamentos</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="menu_maintenance_root" model="ir.ui.menu">
        <field name="name">Manutenção</field>
        <field name="sequence">65</field>
    </record>
    <record id="menu_requests" model="ir.ui.menu">
        <field name="name">Solicitações</field>
        <field name="parent_id" ref="menu_maintenance_root"/>
        <field name="sequence">10</field>
        <field name="action">maintenance.action_requests</field>
    </record>
    <record id="menu_equipments" model="ir.ui.menu">
        <field name="name">Equipamentos</field>
        <field name="parent_id" ref="menu_maintenance_root"/>
        <field name="sequence">20</field>
        <field name="action">maintenance.action_equipments</field>
    </record>
</odoo>
