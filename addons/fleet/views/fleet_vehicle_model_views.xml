<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_model_brand_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.model.brand.list</field>
        <field name="model">fleet.vehicle.model.brand</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="name" string="Marca"/></list></field>
    </record>

    <record id="action_model_brands" model="ir.actions.act_window">
        <field name="name">Marcas</field>
        <field name="res_model">fleet.vehicle.model.brand</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_model_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.model.list</field>
        <field name="model">fleet.vehicle.model</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><list><field name="name" string="Modelo"/><field name="brand_id" string="Marca"/><field name="vehicle_type" string="Tipo"/></list></field>
    </record>

    <record id="view_model_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.model.form</field>
        <field name="model">fleet.vehicle.model</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml"><form><group><field name="name" string="Modelo"/><field name="brand_id" string="Marca"/><field name="vehicle_type" string="Tipo"/></group><group><field name="seats" string="Lugares"/><field name="doors" string="Portas"/><field name="transmission" string="Câmbio"/></group></form></field>
    </record>

    <record id="action_models" model="ir.actions.act_window">
        <field name="name">Modelos</field>
        <field name="res_model">fleet.vehicle.model</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
